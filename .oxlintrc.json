{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    },
    "./scripts/oxlint/shift-plugin.mjs"
  ],
  "rules": {
    "eslint/no-unused-expressions": "off",
    "typescript/no-useless-empty-export": "off",
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "ExpressionStatement > ChainExpression > CallExpression[optional=true]",
        "message": "Do not use foo?.() as a statement. Use an explicit guard: if (foo) foo();"
      },
      {
        "selector": "ExpressionStatement > ChainExpression > MemberExpression[optional=true]",
        "message": "Do not use foo?.bar as a statement (unused). Either call it or remove it."
      },
      {
        "selector": "ExportAllDeclaration",
        "message": "Do not use export *. Use named exports to keep the public API explicit."
      }
    ],
    "shift/no-raw-segment-parse": "error",
    "shift/no-unbranded-ids": "error",
    "shift/no-snapshot-in-domain": "error",
    "shift/no-raw-point-type-check": "error",
    "shift/no-nested-ternary-map": "error",
    "eslint/no-nested-ternary": "error",
    "shift/no-inline-coordinate-math": "off",
    "shift/no-repeated-optional-chain": "warn",
    "shift/no-section-divider-comments": "error",
    "shift/no-bridge-import": "error",
    "shift/no-reference-module-outside-tests": "error",
    "shift/no-raw-editor-in-tests": "error",
    "shift/no-vi-stub-global-in-tests": "error",
    "shift/no-vitest-mock-primitives": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "import/no-duplicates": "error",
    "typescript/consistent-type-imports": "error",
    "shift/no-manual-index-wrap": "error",
    "shift/brand-cast-via-helper": "error",
    "shift/prefer-iterator-helpers": "error",
    "shift/prefer-scene-only": "error",
    "shift/no-optional-collection-field": "error",
    "shift/no-map-get-to-null": "error",
    "shift/no-inline-comparator": "error",
    "shift/no-page-evaluate-in-specs": "off",
    "shift/no-agent-types-in-behaviour-tests": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/testing/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/testing/**/*.ts"],
      "rules": {
        "shift/no-escape-hatch-reads": "error",
        "shift/no-test-type-escapes": "off",
        "shift/no-wire-shapes-in-tests": "off"
      }
    }
  ]
}

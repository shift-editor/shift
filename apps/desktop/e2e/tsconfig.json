{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "files": [
    "../src/renderer/src/types/window.ts",
    "../src/renderer/src/types/electron.d.ts",
    "../src/renderer/src/types/svg.d.ts",
    "../src/renderer/env.d.ts"
  ],
  "include": ["./**/*.ts"],
  // perf.spec.ts still calls a removed layer API; the performance rewrite restores it.
  "exclude": ["./perf.spec.ts"]
}

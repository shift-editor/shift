{
  "name": "@shift/desktop",
  "productName": "Shift",
  "version": "0.1.0",
  "private": true,
  "description": "Shift font editor - desktop application",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "tsx build.ts",
    "package": "pnpm build && electron-builder --config electron-builder.config.ts --dir --publish never",
    "make": "pnpm build && electron-builder --config electron-builder.config.ts --publish never",
    "typecheck": "tsgo --noEmit -p tsconfig.build.json && tsgo --noEmit -p tsconfig.config.json",
    "lint": "oxlint --fix src/",
    "lint:check": "oxlint --deny-warnings src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "pnpm --workspace-root generate:glyph-info && tsx build.ts --e2e",
    "test:e2e": "pnpm build:e2e && pnpm exec playwright test --project=visual --project=gpu",
    "test:e2e:visual": "pnpm build:e2e && pnpm exec playwright test --project=visual",
    "test:e2e:visual:update": "pnpm build:e2e && pnpm exec playwright test --project=visual --update-snapshots=changed",
    "test:e2e:gpu": "pnpm build:e2e && pnpm exec playwright test --project=gpu",
    "test:e2e:perf": "pnpm build:e2e && pnpm exec playwright test --project=perf"
  },
  "author": {
    "name": "Kostya Farber",
    "email": "kostya.farber@gmail.com"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@webgpu/types": "^0.1.69",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "oxlint": "^1.58.0",
    "oxlint-plugin-eslint": "^1.58.0",
    "tailwindcss": "^4.1.11",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@shift/bridge": "workspace:*",
    "@shift/geo": "workspace:*",
    "@shift/glyph-info": "workspace:*",
    "@shift/glyph-state": "workspace:*",
    "@shift/rules": "workspace:*",
    "@shift/types": "workspace:*",
    "@shift/ui": "workspace:*",
    "@shift/validation": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.3.0",
    "regl": "^2.1.1",
    "shift-bridge": "workspace:*",
    "zod": "^4.1.12"
  }
}

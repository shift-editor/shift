{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["files", "exports"],
  "entry": [],
  "project": [],
  "ignore": [
    "apps/desktop/src/renderer/src/testing/setup.ts",
    "apps/desktop/src/renderer/src/testing/stubCanvas.ts"
  ],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["scripts/find-refs.ts", "scripts/oxlint/shift-plugin.mjs"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/main.ts",
        "src/preload/preload.ts",
        "src/utility/workspace.ts",
        "src/renderer/renderer.ts",
        "forge.config.ts",
        "vite.main.config.ts",
        "vite.preload.config.ts",
        "vite.renderer.config.ts",
        "e2e/**/*.ts",
        "src/**/*.bench.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts", "e2e/**/*.ts", "!src/**/*.d.ts"],
      "ignoreDependencies": ["oxlint-plugin-eslint", "shift-bridge", "tailwindcss"]
    },
    "packages/geo": {
      "project": ["src/**/*.ts"]
    },
    "packages/glyph-info": {
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/rules": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/validation": {
      "project": ["src/**/*.ts"]
    }
  }
}

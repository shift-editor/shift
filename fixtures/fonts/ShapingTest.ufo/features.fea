languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn TRK;
languagesystem arab dflt;

feature locl {
    script latn;
    language TRK;
    sub i by i.loclTRK;
    script arab;
    sub one by one.arab;
} locl;

feature ccmp {
    sub noon-ar by noonDotless-ar dotabove-ar;
} ccmp;

feature liga {
    sub f i by f_i;
} liga;

feature dlig {
    sub f f by f_i;
} dlig;

feature init {
    sub beh-ar by beh-ar.init;
} init;

feature medi {
    sub beh-ar by beh-ar.medi;
} medi;

feature fina {
    sub beh-ar by beh-ar.fina;
} fina;

{
  "name": "@shift/editor",
  "version": "0.0.1",
  "private": true,
  "description": "Browser-safe Shift editor runtime",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./clipboard": {
      "types": "./src/clipboard.ts",
      "import": "./src/clipboard.ts"
    },
    "./model": {
      "types": "./src/model.ts",
      "import": "./src/model.ts"
    },
    "./rendering": {
      "types": "./src/rendering.ts",
      "import": "./src/rendering.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./src/ui.ts"
    },
    "./style.css": "./src/ui/style.css",
    "./signals": {
      "types": "./src/signals.ts",
      "import": "./src/signals.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "import": "./src/text.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "import": "./src/tools.ts"
    },
    "./transform": {
      "types": "./src/transform.ts",
      "import": "./src/transform.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./variation": {
      "types": "./src/variation.ts",
      "import": "./src/variation.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --fix src/",
    "lint:check": "oxlint --deny-warnings src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shift/geo": "workspace:*",
    "@shift/glyph-state": "workspace:*",
    "@shift/rules": "workspace:*",
    "@shift/types": "workspace:*",
    "@shift/ui": "workspace:*",
    "@shift/validation": "workspace:*",
    "regl": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "oxlint": "^1.58.0",
    "oxlint-plugin-eslint": "^1.58.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}

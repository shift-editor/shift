{
  "name": "@shift/editor",
  "version": "0.0.1",
  "private": true,
  "description": "Browser-safe Shift editor runtime",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "import": "./src/types/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --fix src/",
    "lint:check": "oxlint --deny-warnings src/"
  },
  "dependencies": {
    "@shift/geo": "workspace:*",
    "@shift/glyph-state": "workspace:*",
    "@shift/rules": "workspace:*",
    "@shift/types": "workspace:*",
    "@shift/validation": "workspace:*",
    "regl": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.1.8",
    "oxlint": "^1.58.0",
    "oxlint-plugin-eslint": "^1.58.0",
    "typescript": "^5.5.4"
  }
}

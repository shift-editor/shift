{
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@shift/types/src/*"],
            "message": "Import from @shift/types, not from its source files."
          },
          {
            "group": ["@/bridge/native"],
            "message": "Do not import getNative() directly. Use NativeBridge instead."
          },
          {
            "group": ["@shift/editor", "@shift/editor/*"],
            "message": "Use relative imports within @shift/editor."
          }
        ]
      }
    ],
    "shift/no-reactive-value-outside-boundary": "error",
    "shift/no-get-signal-value-method": "error",
    "shift/no-mutable-collection-field": "error"
  }
}

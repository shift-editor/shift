{
  "name": "@shift/wasm",
  "version": "0.0.1",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "description": "Shift's shared Rust rules for the editor, compiled from crates/shift-wasm",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "import": "./src/engine.ts"
    },
    "./protocol": {
      "types": "./src/generated-protocol/index.ts",
      "import": "./src/generated-protocol/index.ts"
    },
    "./store-reader": {
      "types": "./src/storeReader.ts",
      "import": "./src/storeReader.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs",
    "types": "node scripts/build.mjs --types",
    "lint": "oxlint --fix src/",
    "lint:check": "oxlint --deny-warnings src/"
  },
  "dependencies": {
    "@shift/pack": "workspace:*",
    "@shift/types": "workspace:*"
  },
  "devDependencies": {
    "binaryen": "132.0.0"
  }
}

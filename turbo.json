{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "index.js", "index.d.ts", "*.node"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "shift-bridge#build": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"]
    },
    "shift-bridge#build:debug": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"]
    },
    "shift-bridge#build:e2e": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"]
    },
    "generate:bridge-types": {
      "dependsOn": ["shift-bridge#build"],
      "inputs": [
        "$TURBO_ROOT$/crates/shift-bridge/index.d.ts",
        "$TURBO_ROOT$/crates/shift-bridge/dts-header.d.ts",
        "$TURBO_ROOT$/scripts/generate-bridge-types.mjs"
      ],
      "outputs": ["src/bridge/generated.ts"]
    },
    "generate": {
      "outputs": ["resources/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate:bridge-types", "generate:bridge-types"],
      "outputs": []
    },
    "@shift/glyph-info#typecheck": {
      "dependsOn": ["generate"],
      "outputs": []
    },
    "@shift/desktop#typecheck": {
      "dependsOn": [
        "@shift/glyph-info#generate",
        "^generate:bridge-types",
        "generate:bridge-types"
      ],
      "outputs": []
    },
    "@shift/desktop#build": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate"
      ],
      "outputs": [".vite/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig*.json",
        "vite*.config.ts",
        "electron-builder.config.ts",
        "resources/**",
        "$TURBO_ROOT$/icons/**"
      ]
    },
    "@shift/desktop#build:e2e": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate"
      ],
      "outputs": [".vite/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig*.json",
        "vite*.config.ts",
        "electron-builder.config.ts",
        "resources/**",
        "$TURBO_ROOT$/icons/**"
      ]
    },
    "@shift/desktop#package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@shift/desktop#make": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@shift/desktop#test:perf": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate"
      ],
      "cache": false,
      "outputs": [],
      "inputs": ["src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:visual": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:visual:update": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:gpu": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:platform": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:perf": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "@shift/glyph-info#test": {
      "dependsOn": ["generate"],
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "@shift/desktop#test": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate"
      ],
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "shift-bridge#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "@shift/glyph-info#test:watch": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    },
    "@shift/desktop#test:watch": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CARGO_INCREMENTAL", "RUSTFLAGS", "CARGO_HOME", "RUSTUP_HOME"]
}

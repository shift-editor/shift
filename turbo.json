{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^generate:bridge-types", "^build"],
      "outputs": ["dist/**", "index.js", "index.d.ts", "*.node"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "shift-bridge#build": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "scripts/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"],
      "env": ["SHIFT_RUST_TARGET"]
    },
    "shift-bridge#build:debug": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "scripts/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"],
      "env": ["SHIFT_RUST_TARGET"]
    },
    "shift-bridge#build:e2e": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "scripts/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"],
      "env": ["SHIFT_RUST_TARGET"]
    },
    "shift-bridge#types": {
      "inputs": [
        "src/**",
        "package.json",
        "Cargo.toml",
        "dts-header.d.ts",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**",
        "$TURBO_ROOT$/packages/pack/src/**",
        "scripts/**"
      ],
      "outputs": ["index.d.ts", "protocol.ts"]
    },
    "@shift/wasm#build": {
      "inputs": [
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**",
        "$TURBO_ROOT$/packages/pack/src/**"
      ],
      "outputs": ["src/generated/**", "src/generated-engine/**", "src/generated-protocol/**"],
      "env": ["SHIFT_WASM_OPT"]
    },
    "@shift/wasm#build:debug": {
      "inputs": [
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**",
        "$TURBO_ROOT$/packages/pack/src/**"
      ],
      "outputs": ["src/generated/**", "src/generated-engine/**", "src/generated-protocol/**"],
      "env": ["SHIFT_WASM_OPT"]
    },
    "@shift/wasm#build:e2e": {
      "inputs": [
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**",
        "$TURBO_ROOT$/packages/pack/src/**"
      ],
      "outputs": ["src/generated/**", "src/generated-engine/**", "src/generated-protocol/**"],
      "env": ["SHIFT_WASM_OPT"]
    },
    "@shift/wasm#types": {
      "inputs": [
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/crates/*/Cargo.toml",
        "$TURBO_ROOT$/crates/*/build.rs",
        "$TURBO_ROOT$/crates/*/src/**",
        "$TURBO_ROOT$/packages/pack/src/**"
      ],
      "outputs": [
        "src/generated*/shift_wasm.d.ts",
        "src/generated*/module.d.ts",
        "src/generated-protocol/**"
      ]
    },
    "generate:bridge-types": {
      "dependsOn": ["shift-bridge#types"],
      "inputs": [
        "$TURBO_ROOT$/crates/shift-bridge/index.d.ts",
        "$TURBO_ROOT$/crates/shift-bridge/protocol.ts",
        "$TURBO_ROOT$/crates/shift-bridge/dts-header.d.ts",
        "$TURBO_ROOT$/scripts/generate-bridge-types.mjs"
      ],
      "outputs": ["src/bridge/generated.ts", "src/bridge/protocol.ts"]
    },
    "generate": {
      "outputs": ["resources/**"]
    },
    "typecheck": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/crates/shift-bridge/index.d.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/generated.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/protocol.ts",
        "$TURBO_ROOT$/packages/wasm/src/generated*/**/*.d.ts"
      ]
    },
    "@shift/glyph-info#typecheck": {
      "dependsOn": ["generate"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/crates/shift-bridge/index.d.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/generated.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/protocol.ts",
        "$TURBO_ROOT$/packages/wasm/src/generated*/**/*.d.ts"
      ]
    },
    "@shift/desktop#typecheck": {
      "dependsOn": ["@shift/glyph-info#generate"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/crates/shift-bridge/index.d.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/generated.ts",
        "$TURBO_ROOT$/packages/types/src/bridge/protocol.ts",
        "$TURBO_ROOT$/packages/wasm/src/generated*/**/*.d.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "@shift/desktop#build": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build"
      ],
      "outputs": [".vite/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig*.json",
        "vite*.config.ts",
        "electron-builder.config.ts",
        "resources/**",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "@shift/desktop#build:e2e": {
      "dependsOn": [
        "shift-bridge#build:e2e",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build:e2e"
      ],
      "outputs": [".vite/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig*.json",
        "vite*.config.ts",
        "electron-builder.config.ts",
        "resources/**",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "@shift/desktop#build:perf": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build:e2e"
      ],
      "outputs": [".vite/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig*.json",
        "vite*.config.ts",
        "electron-builder.config.ts",
        "resources/**",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "@shift/desktop#package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@shift/desktop#make": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@shift/desktop#test:perf": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build"
      ],
      "cache": false,
      "outputs": [],
      "inputs": ["src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:visual": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:visual:update": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:gpu": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:platform": {
      "dependsOn": ["build:e2e"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "@shift/desktop#test:e2e:perf": {
      "dependsOn": ["build:perf"],
      "cache": false,
      "outputs": [],
      "inputs": ["e2e/**", "playwright.config.ts", "src/**", "*.config.ts", "package.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/scripts/oxlint/**"]
    },
    "lint:check": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/scripts/oxlint/**"]
    },
    "test": {
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"],
      "dependsOn": ["^generate:bridge-types", "generate:bridge-types", "@shift/wasm#build"]
    },
    "@shift/editor#test": {
      "outputs": [],
      "inputs": ["src/**", "*.config.ts", "$TURBO_ROOT$/packages/*/src/**"],
      "dependsOn": ["^generate:bridge-types", "generate:bridge-types", "@shift/wasm#build"]
    },
    "@shift/glyph-info#test": {
      "dependsOn": ["^generate:bridge-types", "generate"],
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "@shift/desktop#test": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build"
      ],
      "outputs": [],
      "inputs": [
        "src/**",
        "*.config.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "shift-bridge#test": {
      "dependsOn": ["build", "@shift/types#generate:bridge-types", "@shift/wasm#build"],
      "outputs": [],
      "inputs": ["src/**", "*.config.ts"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate:bridge-types", "generate:bridge-types", "@shift/wasm#build"]
    },
    "@shift/glyph-info#test:watch": {
      "dependsOn": ["^generate:bridge-types", "generate"],
      "cache": false,
      "persistent": true
    },
    "@shift/desktop#test:watch": {
      "dependsOn": [
        "shift-bridge#build",
        "@shift/types#generate:bridge-types",
        "@shift/glyph-info#generate",
        "@shift/wasm#build"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CARGO_INCREMENTAL", "RUSTFLAGS", "CARGO_HOME", "RUSTUP_HOME"]
}
